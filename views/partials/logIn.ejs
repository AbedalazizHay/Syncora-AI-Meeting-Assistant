<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>signup</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <style>
      body {
        padding: 0;
        margin: 0;
        height: 100vh;
      }
      .logo {
        display: flex;
        align-items: center;
        justify-content: center; /* Centers the icon and text horizontally */
        gap: 10px;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin-top: 2rem; /* Adds space between the top of the card and the logo */
      }

      .logo-icon {
        width: 44px;
        height: 44px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: linear-gradient(135deg, #6d5dfc, #8b5cf6);

        font-weight: 800;
      }
    </style>
  </head>
  <body>
    <% if (error === "Invalid email or password.") { %>
  <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm"
       role="alert">

    <i class="bi bi-exclamation-circle-fill fs-5"></i>

    <div>
      <strong>Login failed</strong>
      <div>Invalid email or password. Please try again.</div>
    </div>

    <button type="button"
            class="btn-close ms-auto"
            data-bs-dismiss="alert"
            aria-label="Close"></button>
  </div>
<% } %>
    <div
      class="modal modal-sheet position-static d-flex bg-body-secondary p-4 py-md-5 justify-content-center align-items-center"
      tabindex="-1"
      role="dialog"
      id="modalSignin"
    >
      <div
        class="modal-dialog"
        style="width: 100%; max-width: 480px; margin: auto"
      >
        <div class="modal-content rounded-4 shadow">
          <div class="logo d-flex justify-content-center pt-4">
            <div class="logo-icon">S</div>
          </div>

          <div class="modal-header p-5 pb-4 border-bottom-0">
            <h1 class="fw-bold mb-0 fs-2">Log in to your account</h1>
            <a href="/" class="btn-close" aria-label="Close"></a>
          </div>
          <div class="modal-body p-5 pt-0">
            <form class="" method="post" id="myForm" action="/register">
              <div class="form-floating mb-3">
                <input
                  type="email"
                  class="form-control rounded-3"
                  id="floatingInput"
                  placeholder="name@example.com"
                  required
                  name="userEmail"
                />
                <label for="floatingInput">Email address</label>
              </div>

              <div class="form-floating mb-3">
                <input
                  type="password"
                  class="form-control rounded-3"
                  id="password"
                  placeholder="Password"
                  required
                  name="userPassword"
                />
                <label for="floatingPassword">Password</label>
              </div>

              <button
                class="w-100 mb-2 btn btn-lg rounded-3 btn-primary"
                type="submit"
              >
                Login
              </button>

              <div class="text-center mt-3 mb-2">
                <small class="text-body-secondary"
                  >Don't have an account?</small
                >
                <a href="/signup" class="text-decoration-none fw-bold ms-1"
                  >Sign Up</a
                >
              </div>
              <hr class="my-4" />
            </form>
          </div>
        </div>
      </div>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script src="/js/signup.js"></script>
  </body>
</html>
