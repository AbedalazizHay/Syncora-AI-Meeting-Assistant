
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Syncora | Smart Global Meeting Scheduling</title>
     
    <link rel="stylesheet" href="/styles/getStartedPage.css">
    
</head>

<body>

    <!-- Navigation -->
    <header class="navbar">
        <div class="logo">
            <span class="logo-icon">S</span>
            <span>Syncora</span>
        </div>
        <div>
             <a href="login.html" class="nav-login">log In</a>
        <a href="login.html" class="nav-login">Sign Up</a>
        </div>
       
        
    </header>

    <!-- Hero Section -->
    <main>

        <section class="hero">

            <div class="hero-content">

                <div class="badge">
                    ✨ AI-Powered Meeting Scheduling
                </div>

                <h1>
                    Find the right time
                    <span>for everyone.</span>
                </h1>

                <p class="hero-description">
                    Syncora helps global teams find meeting times that work
                    across different time zones and working hours.
                    Let AI understand your requirements and find the best
                    options for everyone.
                </p>

                <div class="hero-buttons">
                    <a href="login.html" class="primary-button">
                        Get Started
                        <span>→</span>
                    </a>

                    <a href="#how-it-works" class="secondary-button">
                        How it works
                    </a>
                </div>

                <div class="hero-note">
                    🌍 Built for teams working across the world
                </div>

            </div>


            <!-- Visual -->
            <div class="hero-visual">

                <div class="glow"></div>

                <div class="schedule-card">

                    <div class="card-header">
                        <div>
                            <span class="small-label">AI SUGGESTION</span>
                            <h3>Best meeting time</h3>
                        </div>

                        <div class="ai-icon">✦</div>
                    </div>


                    <div class="meeting-time">
                        <div class="calendar-icon">
                            📅
                        </div>

                        <div>
                            <strong>Tomorrow</strong>
                            <p>10:00 AM — 10:45 AM</p>
                        </div>
                    </div>


                    <div class="participants">

                        <div class="participant">
                            <div class="avatar avatar-one">A</div>

                            <div>
                                <strong>Ahmed</strong>
                                <span>Amsterdam · 10:00</span>
                            </div>

                            <div class="check">✓</div>
                        </div>


                        <div class="participant">
                            <div class="avatar avatar-two">J</div>

                            <div>
                                <strong>John</strong>
                                <span>New York · 04:00</span>
                            </div>

                            <div class="check">✓</div>
                        </div>


                        <div class="participant">
                            <div class="avatar avatar-three">M</div>

                            <div>
                                <strong>Maria</strong>
                                <span>Beirut · 11:00</span>
                            </div>

                            <div class="check">✓</div>
                        </div>

                    </div>


                    <div class="card-footer">
                        <span>✓ Everyone is available</span>
                        <span>45 min</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- How It Works -->
        <section class="how-it-works" id="how-it-works">

            <div class="section-heading">

                <span class="section-label">HOW IT WORKS</span>

                <h2>
                    Scheduling across time zones,
                    <span>made simple.</span>
                </h2>

                <p>
                    Syncora takes the complexity out of global scheduling.
                    You tell us what you need, and we help find a time
                    that works for everyone.
                </p>

            </div>


            <div class="steps">

                <div class="step">

                    <div class="step-number">01</div>

                    <h3>Tell us what you need</h3>

                    <p>
                        Describe your meeting naturally or enter the
                        details yourself.
                    </p>

                </div>


                <div class="step">

                    <div class="step-number">02</div>

                    <h3>AI understands</h3>

                    <p>
                        Our AI turns your requirements into structured
                        meeting preferences.
                    </p>

                </div>


                <div class="step">

                    <div class="step-number">03</div>

                    <h3>Find a suitable time</h3>

                    <p>
                        Syncora compares time zones and working hours
                        to find feasible meeting options.
                    </p>

                </div>

            </div>

        </section>


        <!-- Final CTA -->
        <section class="final-cta">

            <div>
                <span class="section-label">READY TO START?</span>

                <h2>
                    Stop calculating time zones.
                    <span>Start syncing.</span>
                </h2>

                <p>
                    Let Syncora make global meeting scheduling easier.
                </p>

                <a href="login.html" class="primary-button">
                    Get Started
                    <span>→</span>
                </a>
            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer>
        <div class="logo">
            <span class="logo-icon">S</span>
            <span>Syncora</span>
        </div>

        <p>
            Smart meeting scheduling for global teams.
        </p>

        <span>© 2026 Syncora</span>
    </footer>


<script src="/js/getStartedPage.js"></script>

</body>
</html>

